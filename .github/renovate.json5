{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'helpers:pinGitHubActionDigests',
  ],
  configMigration: true,
  rebaseWhen: 'behind-base-branch',
  labels: [
    'dependencies',
  ],
  enabledManagers: [
    'github-actions',
    'custom.regex',
  ],
  customManagers: [
    // Tracks upstream's GitHub releases rather than the apt repository the
    // .debs are actually downloaded from.
    //
    // The deb datasource cannot read that repository: it fetches Packages.gz
    // unconditionally (`const compression = 'gz'`, no uncompressed fallback),
    // while Google's Artifact Registry serves only an uncompressed Packages
    // index. Every lookup came back `no-result`.
    //
    // Upstream tags each release vX.Y.Z and publishes the identically
    // versioned .deb, verified across v1.52.1 through v1.55.1, so the release
    // tag is a faithful proxy. scripts/resolve-deb.py still reads the apt
    // index for the filename hash and checksum, and fails loudly if the .deb
    // for a tagged release is not published yet.
    {
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)PKGBUILD$/',
      ],
      matchStrings: [
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\npkgver=(?<currentValue>\\S+)',
      ],
      // pkgver carries no leading v; the release tags do.
      extractVersionTemplate: '^v(?<version>.+)$',
      versioningTemplate: 'semver',
    },
  ],
  packageRules: [
    // Both packages track the same upstream release, so without grouping they
    // would produce two PRs that each break the other's release.
    {
      groupName: 'cuttlefish',
      matchPackageNames: [
        'google/android-cuttlefish',
      ],
      commitMessageTopic: 'cuttlefish',
    },
  ],
}
