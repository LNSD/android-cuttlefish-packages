# Reproduces the parts of upstream's postinst that cannot be expressed as
# packaged files. The rest (modules-load.d, sysusers.d, udev rules, the systemd
# unit) is handled natively by Arch from the paths the package installs.

_bindir=/usr/lib/cuttlefish-common/bin

post_install() {
    # Upstream insists this exists and is a directory; it is the home directory
    # of the _cutf-operator user that cuttlefish-user creates.
    mkdir -p /var/empty

    # File capabilities cannot be set from package(): makepkg builds under
    # fakeroot, which does not implement the security.capability xattr.
    setcap cap_net_admin,cap_net_bind_service,cap_net_raw=+ep "${_bindir}/cvdalloc"
    setcap cap_setgid=+ep "${_bindir}/cvd_refresh_groups"

    # modules-load.d only takes effect at boot; load them now so the first CVD
    # after install works without a reboot.
    if [ -f /etc/modules-load.d/cuttlefish-common.conf ]; then
        while read -r module || [ -n "${module}" ]; do
            case "${module}" in
                \#*|'') continue ;;
            esac
            modprobe "${module}" || true
        done < /etc/modules-load.d/cuttlefish-common.conf
    fi

    cat <<'EOF'
:: cuttlefish-base installed.

   Add yourself to the cvdnetwork group, then log out and back in:

       sudo usermod -aG cvdnetwork "$USER"

   Enable the host resources unit:

       sudo systemctl enable --now cuttlefish-host-resources.service

   /dev/kvm must be accessible to you. Check with: ls -l /dev/kvm
EOF
}

post_upgrade() {
    post_install
}
