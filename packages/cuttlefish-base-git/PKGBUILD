# Maintainer: Lorenzo Delgado <lnsdev@proton.me>
#
# Builds cuttlefish-base from upstream git. This mirrors what upstream's
# debian/rules does, minus debhelper: the same bazel invocation, then the file
# mapping from debian/cuttlefish-base.install and .links applied by hand.
#
# For the prebuilt binaries from Google's own .deb, use cuttlefish-base-bin
# instead. That is the package this repository publishes; this one exists to
# build HEAD locally.

_debpkg=cuttlefish-base
pkgname="${_debpkg}-git"
pkgver=1.55.1.r0.g0000000
pkgrel=1
pkgdesc="Cuttlefish Android Virtual Device host package (built from git)"
arch=('x86_64')
url="https://github.com/google/android-cuttlefish"
license=('Apache-2.0')

provides=("${_debpkg}")
conflicts=("${_debpkg}" "${_debpkg}-bin")

depends=(
  'glibc' 'gcc-libs' 'xz' 'opus'
  'curl' 'dnsmasq' 'iproute2' 'iptables' 'jq' 'less'
  'libarchive' 'libcap' 'net-tools' 'nftables' 'openssl' 'opus-tools'
  'python' 'xdg-utils'
)
# bazelisk rather than bazel: base/cvd pins a version in .bazelversion, and
# bazelisk is what honours it.
makedepends=('git' 'bazelisk' 'clang' 'python')
optdepends=('grub: EFI bootloader images for the guest')

install="${pkgname}.install"

backup=(
  'etc/NetworkManager/conf.d/99-cuttlefish.conf'
  'etc/default/cuttlefish-host-resources'
  'etc/modules-load.d/cuttlefish-common.conf'
  'etc/security/limits.d/1_cuttlefish.conf'
)

# bazel emits its own build ids and runfiles trees; leave them intact.
options=('!strip' '!debug' '!lto')

source=("${pkgname}::git+https://github.com/google/android-cuttlefish.git")
sha256sums=('SKIP')

pkgver() {
  cd "${srcdir}/${pkgname}"
  # Upstream tags releases vX.Y.Z; describe against the last one.
  printf '%s.r%s.g%s' \
    "$(git describe --tags --abbrev=0 | sed 's/^v//')" \
    "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short HEAD)"
}

build() {
  cd "${srcdir}/${pkgname}/base/cvd"

  # Taken from upstream's debian/rules override_dh_auto_build. --spawn_strategy
  # =local avoids bazel's sandbox, which does not survive makepkg's fakeroot;
  # the clang-tidy tag filter skips lint-only targets.
  bazelisk build -c opt \
    'cuttlefish/package:cvd' \
    'cuttlefish/package:defaults' \
    'cuttlefish/package:metrics' \
    --spawn_strategy=local \
    --workspace_status_command=../stamp_helper.sh \
    --build_tag_filters=-clang-tidy
}

package() {
  cd "${srcdir}/${pkgname}/base"

  # debian/cuttlefish-base.install: the bazel output tree becomes /usr/lib/
  # cuttlefish-common. k8 is bazel's name for x86_64.
  install -d "${pkgdir}/usr/lib"
  cp -a cvd/bazel-out/k8-opt/bin/cuttlefish/package/cuttlefish-common \
    "${pkgdir}/usr/lib/"

  install -Dm755 host/deploy/capability_query.py \
    -t "${pkgdir}/usr/lib/cuttlefish-common/bin"

  # The /etc payload ships as a plain tree in the source.
  cp -a host/packages/cuttlefish-base/etc "${pkgdir}/"

  # debian/rules override_dh_install strips bazel bookkeeping.
  rm -rf "${pkgdir}"/usr/lib/cuttlefish-common/bin/cvd.repo_mapping \
    "${pkgdir}"/usr/lib/cuttlefish-common/bin/cvd.runfiles*

  # debhelper would install these; do it directly, and to Arch's paths.
  install -Dm644 debian/${_debpkg}.cuttlefish-host-resources.service \
    "${pkgdir}/usr/lib/systemd/system/cuttlefish-host-resources.service"
  install -Dm644 debian/${_debpkg}.udev \
    "${pkgdir}/usr/lib/udev/rules.d/60-cuttlefish-base.rules"
  install -Dm644 debian/${_debpkg}.cuttlefish-host-resources.default \
    "${pkgdir}/etc/default/cuttlefish-host-resources"

  # The unit's ExecStart is the SysV script even in upstream's source form, so
  # the script is installed (outside /etc/init.d, which Arch does not use) and
  # the unit repointed at it.
  local _initdir="${pkgdir}/usr/lib/cuttlefish-common/init"
  install -Dm755 debian/${_debpkg}.cuttlefish-host-resources.init \
    "${_initdir}/cuttlefish-host-resources"
  sed -i 's#/etc/init.d/#/usr/lib/cuttlefish-common/init/#g' \
    "${pkgdir}/usr/lib/systemd/system/cuttlefish-host-resources.service"

  # Sourced but never called; Arch has no /lib/lsb/init-functions.
  sed -i '/^\. \/lib\/lsb\/init-functions$/d' \
    "${_initdir}/cuttlefish-host-resources"

  # debian/cuttlefish-base.links
  install -d "${pkgdir}/usr/bin"
  ln -sf /usr/lib/cuttlefish-common/bin/cvd "${pkgdir}/usr/bin/cvd"

  install -Dm644 "${srcdir}/${pkgname}/base/debian/copyright" \
    "${pkgdir}/usr/share/licenses/${pkgname}/copyright"

  install -Dm644 "${startdir}/${pkgname}.sysusers" \
    "${pkgdir}/usr/lib/sysusers.d/${pkgname}.conf"
}
