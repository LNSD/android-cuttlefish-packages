# Maintainer: Lorenzo Delgado <lnsdev@proton.me>
#
# Builds cuttlefish-user from upstream git, mirroring frontend/debian/rules
# minus debhelper: the same two Go builds and the web UI build, then the file
# mapping from debian/cuttlefish-user.install and .links.
#
# For the prebuilt binaries from Google's own .deb, use cuttlefish-user-bin.

_debpkg=cuttlefish-user
pkgname="${_debpkg}-git"
pkgver=1.55.1.r0.g0000000
pkgrel=1
pkgdesc="Cuttlefish web operator, browser access to running devices (built from git)"
arch=('x86_64')
url="https://github.com/google/android-cuttlefish"
license=('Apache-2.0')

provides=("${_debpkg}")
conflicts=("${_debpkg}" "${_debpkg}-bin")

depends=('cuttlefish-base' 'glibc' 'openssl')
makedepends=('git' 'go' 'npm' 'nodejs')

install="${pkgname}.install"
backup=('etc/default/cuttlefish-operator')
options=('!strip' '!debug' '!lto')

source=("${pkgname}::git+https://github.com/google/android-cuttlefish.git")
sha256sums=('SKIP')

pkgver() {
  cd "${srcdir}/${pkgname}"
  printf '%s.r%s.g%s' \
    "$(git describe --tags --abbrev=0 | sed 's/^v//')" \
    "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short HEAD)"
}

build() {
  cd "${srcdir}/${pkgname}/frontend"

  # Flags taken from frontend/debian/rules override_dh_auto_build.
  export CGO_ENABLED=1
  (cd src/operator && go build -v -buildmode=pie -ldflags='-w')
  (cd src/host_orchestrator && go build -v -buildmode=pie -ldflags='-w')

  # Builds src/operator/webui/dist/static; fetches npm dependencies.
  ./build-webui.sh
}

package() {
  cd "${srcdir}/${pkgname}/frontend"

  # debian/cuttlefish-user.install
  install -Dm755 src/operator/operator \
    -t "${pkgdir}/usr/lib/cuttlefish-common/bin"
  install -Dm755 src/host_orchestrator/host_orchestrator \
    -t "${pkgdir}/usr/lib/cuttlefish-common/bin"

  install -d "${pkgdir}/usr/share/cuttlefish-common/operator"
  cp -a src/operator/webui/dist/static \
    "${pkgdir}/usr/share/cuttlefish-common/operator/"
  cp -a src/operator/intercept \
    "${pkgdir}/usr/share/cuttlefish-common/operator/"

  # debhelper would install these; do it directly, and to Arch's paths.
  install -Dm644 debian/cuttlefish-orchestration.cuttlefish-host_orchestrator.service \
    "${pkgdir}/usr/lib/systemd/system/cuttlefish-operator.service"
  install -Dm644 debian/cuttlefish-orchestration.cuttlefish-host_orchestrator.default \
    "${pkgdir}/etc/default/cuttlefish-operator"

  # As in cuttlefish-base-git: the unit executes the SysV script, so relocate
  # it and repoint the unit rather than dropping it.
  local _initdir="${pkgdir}/usr/lib/cuttlefish-common/init"
  install -Dm755 debian/cuttlefish-orchestration.cuttlefish-host_orchestrator.init \
    "${_initdir}/cuttlefish-operator"
  sed -i 's#/etc/init.d/cuttlefish-host_orchestrator#/usr/lib/cuttlefish-common/init/cuttlefish-operator#g' \
    "${pkgdir}/usr/lib/systemd/system/cuttlefish-operator.service"
  sed -i '/^\. \/lib\/lsb\/init-functions$/d' "${_initdir}/cuttlefish-operator"

  # debian/cuttlefish-user.links
  install -d "${pkgdir}/usr/bin"
  ln -sf /usr/lib/cuttlefish-common/bin/host_orchestrator \
    "${pkgdir}/usr/bin/cvd_host_orchestrator"

  install -Dm644 debian/copyright \
    "${pkgdir}/usr/share/licenses/${pkgname}/copyright"

  install -Dm644 "${startdir}/${pkgname}.sysusers" \
    "${pkgdir}/usr/lib/sysusers.d/${pkgname}.conf"
}
